# Both variables below are OPTIONAL for local development.
# Leave them unset and the app automatically uses a local SQLite file
# at ./data/lostfound.db - no signup, no cost, nothing to configure.
#
# They are only needed when deploying to Vercel (or any other host with a
# non-persistent filesystem), where a local file can't be relied on to
# survive between requests. In that case, create a free database at
# https://turso.tech, then set:

# libsql:// URL of your Turso database
TURSO_DATABASE_URL=

# Auth token generated for that database (turso db tokens create <db-name>)
TURSO_AUTH_TOKEN=
